{
  "name": "pi-codex-otel",
  "version": "0.0.1",
  "description": "Export Pi and Oh My Pi activity as Codex-compatible OpenTelemetry logs.",
  "keywords": [
    "codex",
    "oh-my-pi",
    "omp",
    "opentelemetry",
    "otlp",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/mkusaka/pi-codex-otel#readme",
  "bugs": {
    "url": "https://github.com/mkusaka/pi-codex-otel/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkusaka/pi-codex-otel.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint src test",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run check",
    "version": "node -e 'const v=process.env.npm_package_version; const fs=require(\"fs\"); fs.writeFileSync(\"src/index.ts\", fs.readFileSync(\"src/index.ts\",\"utf8\").replace(/const EXTENSION_VERSION = \"[^\"]+\"/, `const EXTENSION_VERSION = \"${v}\"`));' && git add src/index.ts"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^24.10.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@11.22.0",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
